# 운영: Supabase PostgreSQL의 Transaction Pooler URI를 서버 환경변수로 설정
APP_ORIGIN=http://localhost:3000
# 운영 전용. GitHub에 값을 올리지 마세요.
DATABASE_URL=
# 로컬 개발에서 기존 SQLite 데이터 사용 시에만 true
LOCAL_SQLITE_DEV=true
DATABASE_PATH=./data/mbco.sqlite
# 이전 스크립트 실행 시 DATABASE_URL의 host[:port]/database와 정확히 일치해야 함
DB_MIGRATION_TARGET=
# 32바이트 hex (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DATA_ENCRYPTION_KEY=
INITIAL_ADMIN_PASSWORD=1111
# 운영 HTTPS에서는 true, 로컬 http에서는 false
COOKIE_SECURE=false
# 프록시가 헤더를 덮어쓰도록 설정한 경우만 true
TRUST_PROXY=false
